#!/bin/sh /etc/rc.common
# J-Box management panel service

USE_PROCD=1
START=98
STOP=11

JBOX_ROOT=/opt/j-box
NODE="$JBOX_ROOT/node/bin/node"
ENTRY="$JBOX_ROOT/panel/server/index.mjs"
DATA="$JBOX_ROOT/data"

start_service() {
	if [ ! -x "$NODE" ]; then
		echo "jbox-panel: node runtime not found at $NODE" >&2
		return 1
	fi
	if [ ! -f "$ENTRY" ]; then
		echo "jbox-panel: panel entry not found at $ENTRY" >&2
		return 1
	fi

	mkdir -p "$DATA"

	procd_open_instance jbox-panel
	# --max-http-header-size:Node 默认 16KB 请求/响应头太小(机场超长响应头会
	# HPE_HEADER_OVERFLOW,见 panel/server/system/insecure-fetch.mjs),统一抬到 64KB。
	procd_set_param command "$NODE" "--max-http-header-size=65536" "$ENTRY"
	# LD_LIBRARY_PATH:x64 的 musl Node 动态依赖 libstdc++.so.6(OpenWrt 默认镜像不带,
	# 见 scripts/build-release.sh 头部 Critical 1 说明),该库随发布包捆绑在
	# node/lib/ 下,靠这个环境变量让动态链接器找到它。
	procd_set_param env \
		PORT=2026 \
		HOST=0.0.0.0 \
		JBOX_ROOT="$JBOX_ROOT" \
		LD_LIBRARY_PATH="$JBOX_ROOT/node/lib" \
		ZASHBOARD_DB_PATH="$DATA/jbox.sqlite"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
